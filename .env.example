# Production URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://devdenlabs.vercel.app

# WhatsApp number with country code, digits only (e.g. 919876543210).
# Leave empty to hide all WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact email (defaults to nikhilpnkr@gmail.com).
NEXT_PUBLIC_CONTACT_EMAIL=

# Freelance landing page from Plan B. Leave empty to hide the link.
NEXT_PUBLIC_FREELANCE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
